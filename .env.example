# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI provider order: groq,github
AI_PROVIDER_ORDER=groq,github
GROQ_API_KEY=
MODEL_NAME=llama-3.3-70b-versatile
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference
GITHUB_MODELS_MODEL=openai/gpt-4.1-mini

# Market data polling
CHECK_INTERVAL_MINUTES=60
NEWS_LOOKBACK_DAYS=7
MAX_NEWS_ITEMS=5

# Dynamic ticker discovery
DAY_GAINERS_LIMIT=10
MOST_ACTIVE_LIMIT=10
TRENDING_NEWS_LIMIT=25
DISCOVERY_REGION=US
DISCOVERY_CACHE_MINUTES=360
MAX_AI_CANDIDATES=3
MIN_SIGNAL_PRICE_CHANGE_PCT=1.0
MIN_SIGNAL_RELATIVE_VOLUME=1.2
REQUEST_TIMEOUT_SECONDS=12
MAX_PARALLEL_TICKERS=1

# Alpaca paper trading
PAPER_TRADING_ENABLED=false
PAPER_TRADING_DRY_RUN=true
PAPER_MIN_CONFIDENCE=75
PAPER_MAX_OPEN_POSITIONS=3
PAPER_MAX_POSITIONS=3
PAPER_MAX_POSITION_PCT=10.0
PAPER_MAX_TRADES_PER_DAY=3
PAPER_MAX_TRADES_PER_TICKER_PER_DAY=1
PAPER_ALLOW_SHORTS=false
PAPER_ALLOW_OPTIONS=false
PAPER_OPTION_MAX_CONTRACTS=10
PAPER_OPTION_MAX_PREMIUM_PCT=20
PAPER_OPTION_MIN_VOLUME=0
PAPER_OPTION_MIN_OPEN_INTEREST=0
PAPER_OPTION_MAX_SPREAD_PCT=100
PAPER_EQUITY_TIME_IN_FORCE=gtc
PAPER_OPTION_TIME_IN_FORCE=gtc
PAPER_OPTION_EXIT_TIME_IN_FORCE=gtc
PAPER_OPTION_EXIT_MODE=take_profit
PAPER_OPTION_STOP_MULT=0.5
PAPER_OPTION_TAKE_PROFIT_MULT=2.0
PAPER_SIGNAL_FILE=signals.jsonl
PAPER_TRADE_LOG=paper_trades.jsonl
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Trading mode: paper or live. Keep paper unless you explicitly intend live orders.
TRADING_MODE=paper

# Alpaca live trading (cash-only guardrails)
LIVE_TRADING_ENABLED=false
LIVE_TRADING_DRY_RUN=true
LIVE_MIN_CONFIDENCE=60
LIVE_MAX_OPEN_POSITIONS=5
LIVE_MAX_POSITION_PCT=100
LIVE_MAX_POSITION_DOLLARS=0
LIVE_CASH_RESERVE_DOLLARS=0
LIVE_MAX_TRADES_PER_DAY=5
LIVE_MAX_TRADES_PER_TICKER_PER_DAY=1
LIVE_ALLOW_SHORTS=false
LIVE_ALLOW_OPTIONS=false
LIVE_OPTION_MAX_CONTRACTS=999
LIVE_OPTION_MAX_PREMIUM_PCT=100
LIVE_OPTION_MAX_PREMIUM_DOLLARS=0
LIVE_OPTION_MIN_VOLUME=0
LIVE_OPTION_MIN_OPEN_INTEREST=0
LIVE_OPTION_MAX_SPREAD_PCT=100
LIVE_OPTION_TIME_IN_FORCE=gtc
LIVE_OPTION_EXIT_MODE=stop
LIVE_OPTION_STOP_MULT=0.5
LIVE_OPTION_TAKE_PROFIT_MULT=2.0
LIVE_OPTION_EXIT_TIME_IN_FORCE=gtc
LIVE_EQUITY_TIME_IN_FORCE=gtc
LIVE_TRADE_LOG=live_trades.jsonl
LIVE_ALPACA_API_KEY_ID=
LIVE_ALPACA_API_SECRET_KEY=
LIVE_ALPACA_BASE_URL=https://api.alpaca.markets

# Runtime
LOG_LEVEL=INFO
STATE_FILE=state.json
TIMEZONE=UTC
